# ==============================================================================
# MailShield Web Frontend — Environment Configuration Example (.env.example)
# Copy this file to '.env' or '.env.production' during build/deployment.
# ==============================================================================

# Backend API Base URL
# - Local Vite Development: '/api/v1' (proxied by vite.config.ts to 127.0.0.1:8000)
# - Production Reverse Proxy / Nginx: '/api/v1'
# - Separate API Subdomain: 'https://api.yourdomain.com/api/v1'
VITE_API_BASE_URL=/api/v1
