# MailShield Configuration Example
PROJECT_NAME=MailShield
API_V1_STR=/api/v1
VERSION=2.1.0
ENVIRONMENT=development
MAILSHIELD_MODE=standard

# Security (Change in production!)
SECRET_KEY=mailshield-super-secret-key-change-in-production-deployments
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Use sqlite for local or postgresql+psycopg2://user:pass@host/dbname for online)
DATABASE_URL=sqlite:///./mailshield.db

# Machine Learning
ARTIFACTS_DIR=ml/artifacts
DEFAULT_MODEL=logistic_regression
DEFAULT_THRESHOLD=0.5

# Upload Limits
MAX_FILE_SIZE_BYTES=5242880
