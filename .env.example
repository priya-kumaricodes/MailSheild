# ==============================================================================
# MailShield v2.1.0 — Environment Configuration Example (.env.example)
# Copy this file to '.env' for local development or set in production hosting secrets.
# DO NOT commit real secrets, private keys, or credentials into version control!
# ==============================================================================

# Application Metadata & Runtime Mode
PROJECT_NAME=MailShield
API_V1_STR=/api/v1
VERSION=2.1.0
ENVIRONMENT=development               # Options: 'development', 'production', 'desktop'
MAILSHIELD_MODE=standard              # Options: 'standard', 'desktop'

# Security & Authentication (MANDATORY: Change to strong random strings in production)
# Generate via: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-secure-random-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440      # 24 hours

# Database Persistence
# Local SQLite default: sqlite:///./mailshield.db
# Production PostgreSQL example: postgresql+psycopg2://user:password@db-host:5432/mailshield_db
DATABASE_URL=sqlite:///./mailshield.db

# Machine Learning Models & Inference
ARTIFACTS_DIR=ml/artifacts
DATA_DIR=ml/data
DEFAULT_MODEL=logistic_regression
DEFAULT_THRESHOLD=0.5

# Upload Size Limits
MAX_FILE_SIZE_BYTES=5242880           # 5 MB maximum file upload size

# Cross-Origin Resource Sharing (CORS)
# In production, set to your exact web domain(s)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000"]

# Google OAuth 2.0 & Gmail Integration (Optional - for Gmail Inbox Scanner)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI_WEB=http://localhost:5173/gmail/callback
GOOGLE_REDIRECT_URI_DESKTOP=http://127.0.0.1:8000/api/v1/gmail/callback/desktop

# Authenticated Token Encryption at Rest (AES-256-GCM via HKDF)
# Used to encrypt sensitive OAuth refresh tokens in the database
# Generate via: python3 -c "import secrets; print(secrets.token_hex(32))"
TOKEN_ENCRYPTION_KEY=change-this-to-a-32-byte-hex-or-base64-encryption-key
TOKEN_ENCRYPTION_KEY_FALLBACK=

